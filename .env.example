# ==========================================
# Judmi Academy - Production Environment Variables
# ==========================================

# 1. Turso Edge Database (Sign up at https://turso.tech)
# Create database: turso db create judmi-academy
# Get URL: turso db show judmi-academy --url
# Get Token: turso db tokens create judmi-academy
TURSO_DATABASE_URL="libsql://judmi-academy-[your-org].turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. Google Gemini AI API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="https://judmi-academy.vercel.app"

# 4. Optional Fabshi Payment Gateway Configuration (for live Mobile Money)
FABSHI_API_KEY=""
FABSHI_API_URL="https://api.fabshi.com"
