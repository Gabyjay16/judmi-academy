# ==========================================
# Judmi Academy - Production Environment Variables Example
# ==========================================

# 1. Turso Edge Database
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. Meta AI Model API Key (PRIMARY - powers AI question generation, essay grading & script marking)
# Obtain your key at: https://ai.developer.meta.com/docs/getting-started/authentication
# This is called FIRST for every AI text call. Default model: muse-spark-1.1 (set META_AI_MODEL to override).
META_AI_API_KEY="LLM_...your_meta_ai_key_here"
META_AI_MODEL="muse-spark-1.1"

# 2b. OpenRouter AI API Key (FALLBACK - used automatically if the Meta AI call fails,
#     and for audio transcription/STT which Meta's API doesn't provide)
# Obtain your key at: https://openrouter.ai/keys
# NOTE: OPENROUTER_API_KEY also works with a Google Gemini Studio key (GEMINI_API_KEY) since the
#       code resolves either OPENROUTER_API_KEY or GEMINI_API_KEY.
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="https://judmi-academy.vercel.app"

# 4. Fapshi Payment Gateway
FAPSHI_API_KEY="your_fapshi_api_key_here"
FAPSHI_API_URL="https://api.fapshi.com"
FABSHI_API_KEY="your_fapshi_api_key_here"
FABSHI_API_URL="https://api.fapshi.com"
