# ==========================================
# Judmi Academy - Production Environment Variables Example
# ==========================================

# 1. Turso Edge Database
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. Google Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="https://judmi-academy.vercel.app"

# 4. Fapshi Payment Gateway
FAPSHI_API_KEY="your_fapshi_api_key_here"
FAPSHI_API_URL="https://api.fapshi.com"
FABSHI_API_KEY="your_fapshi_api_key_here"
FABSHI_API_URL="https://api.fapshi.com"
