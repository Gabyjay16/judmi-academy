# ==========================================
# Judmi Academy - Production Environment Variables Example
# ==========================================

# 1. Turso Edge Database
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. OpenRouter AI API Key (powers AI question generation, essay grading & script marking)
# Obtain your key at: https://openrouter.ai/keys
# NOTE: This also works with a Google Gemini Studio key (GEMINI_API_KEY) since the
#       code resolves either OPENROUTER_API_KEY or GEMINI_API_KEY.
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="https://judmi-academy.vercel.app"

# 4. Fapshi Payment Gateway
FAPSHI_API_KEY="your_fapshi_api_key_here"
FAPSHI_API_URL="https://api.fapshi.com"
FABSHI_API_KEY="your_fapshi_api_key_here"
FABSHI_API_URL="https://api.fapshi.com"
